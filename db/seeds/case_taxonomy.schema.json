{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asoe.local/schemas/case-taxonomy/v1.json",
  "title": "Case & Intent Super-Group taxonomy seed",
  "description": "Steward-owned source of truth for the case taxonomy. Loader (scripts/seed_taxonomy.py) writes this to case_supergroup, case_intent, supergroup_intent_allowed, intent_label. Generator (scripts/generate_taxonomy_constants.py) emits Python and TypeScript constants from the same file.",
  "type": "object",
  "required": ["version", "supergroups", "intents", "labels"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Steward-assigned version tag, e.g. '2026-05-27-v1'. Incremented per Steward change.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-v[0-9]+$"
    },
    "supergroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "origin", "description", "owner_role", "sort_order"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^SG_[A-Z][A-Z0-9_]*$"},
          "origin": {"enum": ["CUSTOMER", "API", "BOTH"]},
          "description": {"type": "string", "minLength": 10},
          "owner_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "sort_order": {"type": "integer", "minimum": 0, "maximum": 9999},
          "deprecated_at": {"type": ["string", "null"], "format": "date"},
          "replaced_by_code": {"type": ["string", "null"], "pattern": "^SG_[A-Z][A-Z0-9_]*$"}
        }
      }
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "supergroup_code", "description"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^INT_[A-Z][A-Z0-9_]*$"},
          "supergroup_code": {"type": "string", "pattern": "^SG_[A-Z][A-Z0-9_]*$"},
          "description": {"type": "string", "minLength": 10},
          "sap_block_code": {"type": ["string", "null"]},
          "sap_block_field": {
            "type": ["string", "null"],
            "enum": [null, "LIFSK", "LIFSP", "FAKSK", "FAKSP", "ABGRU", "CMGST", "Z_CUSTOM"]
          },
          "sap_sales_org": {"type": ["string", "null"]},
          "phase_zero_pending": {"type": "boolean", "default": false},
          "deprecated_at": {"type": ["string", "null"], "format": "date"},
          "replaced_by_code": {"type": ["string", "null"], "pattern": "^INT_[A-Z][A-Z0-9_]*$"}
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "domain", "display_name"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^(SG|INT)_[A-Z][A-Z0-9_]*$"},
          "domain": {"enum": ["SUPERGROUP", "INTENT"]},
          "locale": {"type": "string", "default": "en"},
          "display_name": {"type": "string", "minLength": 1},
          "description": {"type": ["string", "null"]}
        }
      }
    }
  }
}
