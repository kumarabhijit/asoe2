# .env.example ─ copy to .env and fill in values
#
# cp .env.example .env
# docker compose up

# ── Proxy (optional — used at build time and runtime) ─────────────────────
# Uncomment and set if behind a corporate proxy.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal.example.com

# ── Database (architecture_v3.md §9.2) ─────────────────────────────────────
# PostgreSQL connection for exception state, audit trail, policy overrides.
# When unset, the API uses an in-memory store (development only).
# DATABASE_URL=postgresql://asoe:asoe_dev@localhost:5432/asoe
POSTGRES_USER=asoe
POSTGRES_PASSWORD=asoe_dev
POSTGRES_DB=asoe

# ── Redis (architecture_v3.md §9.3) ───────────────────────────────────────
# Redis for pub/sub, task queue, session cache, circuit breaker state.
# REDIS_URL=redis://localhost:6379/0

# ── Postgres connection-timeout (PARITY-0 Phase 0a) ───────────────────────
# Default 5s; capped at 60s. Prevents a Postgres outage from cascading
# into readiness-probe failure / revision churn.
# ASOE_POSTGRES_CONNECT_TIMEOUT_S=5

# ── Attachment object store (ADR-044 §2.1 / PARITY-2) ─────────────────────
# Pluggable attachment-blob backend. Defaults to in-memory (dev only).
# Override per deployment:
#   ASOE_ATTACHMENT_BACKEND  = memory | db | object_store
#   ASOE_OBJECT_STORE_DRIVER = filesystem | s3 | azure
# Filesystem (default object-store driver — infra-free for dev):
#   ASOE_OBJECT_STORE_PATH=./.asoe_object_store
# S3 / MinIO (live path):
#   ASOE_OBJECT_STORE_BUCKET=asoe-attachments
#   ASOE_OBJECT_STORE_ENDPOINT=https://s3.amazonaws.com   # or MinIO URL
# Azure Blob Storage (live path; requires `pip install asoe[azure]`):
#   ASOE_OBJECT_STORE_BUCKET=asoe-attachments
#   ASOE_OBJECT_STORE_ENDPOINT=https://<account>.blob.core.windows.net
#   (Auth via DefaultAzureCredential — managed identity in production.)

# ── Attachment read-token TTL (ADR-044 §2.2) ──────────────────────────────
# Short-TTL scoped capability token for the signed-read endpoint.
# ASOE_ATTACHMENT_READ_TTL_SECONDS=300

# ── Security (architecture_v3.md §11) ──────────────────────────────────────
# JWT signing secret — REQUIRED for production (Key Vault-managed).
# Dev fallback used when unset. NEVER use the dev fallback in production.
# ASOE_JWT_SECRET=<your-production-secret>

# Environment isolation (§11.6): "sandbox" or "production".
# JWT env claim must match this value — mismatch returns 403.
ASOE_ENV=sandbox

# Sandbox case bootstrap. When "1" (and ASOE_ENV=sandbox), the API runs
# every fixtures/scenarios/catalog.yaml EDI scenario through the graph on
# startup and persists the resulting cases, so a fresh sandbox backend
# exposes the same queue the asoe-ui mock is generated from (deployment
# parity). Idempotent — seeds once against a populated store. Ignored
# outside sandbox. See api/sandbox_bootstrap.py.
ASOE_SANDBOX_BOOTSTRAP=0

# ── Safety switches ────────────────────────────────────────────────────────
# Set to 1 to halt all execution before any LangGraph node runs.
ASOE_KILL_SWITCH=0

# Set to 1 for dry-run mode (no recipe side effects).
ASOE_EXPLAIN_MODE=0

# ── LangFuse observability (optional) ─────────────────────────────────
# Set both keys to enable trace forwarding to LangFuse.
# Omit LANGFUSE_HOST for LangFuse Cloud; set for self-hosted instances.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://langfuse.your-domain.com

# ── Inference (only needed with --profile inference) ─────────────────────
# Lightweight model for local dev:
LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# Production Compliance Shadow model (architecture_v3.md §4):
# LOCAL_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Device: cpu | cuda | mps
LOCAL_LLM_DEVICE=cpu

# Set to activate the local LLM backend in the UI:
# LOCAL_LLM_BACKEND_CLASS=tests.sandbox.llm.local_backend.LocalHFBackend

# ── Remote LLM provider routing (V1 PR-1) ─────────────────────────────────
# Picks which provider serves the constrained-generation trio
# (classify_intent / propose_recipe / shadow_decision). Default
# is `fallback` — every trio call is served by the deterministic
# rule engine and NO outbound LLM traffic occurs.
#
# Allowed values: anthropic | openai | google | ollama |
# huggingface | outlines | local | fallback
# ASOE_LLM_PROVIDER=fallback

# Per-task overrides — flip a single trio method without touching
# the others. Empty / unset → use the global ASOE_LLM_PROVIDER.
# ASOE_LLM_PROVIDER_INTENT=anthropic
# ASOE_LLM_PROVIDER_RECIPE=anthropic
# ASOE_LLM_PROVIDER_SHADOW=fallback   # SOX: stays deterministic in V1
# ASOE_LLM_PROVIDER_EMAIL_SUPERGROUP=anthropic  # ADR-036 Phase 3 (customer-email classifier)

# Runtime kill-by-task. Comma-separated list of tasks pinned to
# the deterministic backend regardless of provider config —
# checked on every router call so an operator can flip mid-incident
# without redeploying.
# ASOE_LLM_DISABLE_FOR=intent,recipe,shadow

# Daily USD budget cap (sandbox shakeout default = $5). Hard-blocks
# the LLM tier and routes to deterministic when reached. Re-checked
# per call.
# ASOE_LLM_DAILY_USD_BUDGET=5.00

# ── Precedents embedding provider (sign-off 2026-06-10) ───────────────────
# 'Similar past cases' semantic matching. Unset (the default) keeps the
# semantic path OFF and precedents fall back to the deterministic
# same-intent / same-customer correlate match — no network, no spend.
# Advisory retrieval only: embeddings never feed a control field, recipe,
# or shadow decision.
#
# Allowed values: openai
# ASOE_EMBEDDING_PROVIDER=openai
# Embedding model id (1536 dims — matches the V001 pgvector column).
# ASOE_EMBEDDING_MODEL=text-embedding-3-small

# ── Email-supergroup classifier (ADR-036 Phase 3) ─────────────────────────
# The customer-email classifier resolves its backend through the same
# router as the trio (provider via ASOE_LLM_PROVIDER[_EMAIL_SUPERGROUP]).
# Two extra knobs govern shadow→gate promotion + the triage threshold:
#
# Shadow mode (default ON). While ON, a live model is OBSERVED + recorded
# for calibration (ECE) but the deterministic shim drives the gating
# decision. Set to 0 ONLY after ECE is acceptable, to promote the live
# model to the gate. Unset/anything-but-"0" = shadow ON.
# ASOE_EMAIL_SUPERGROUP_SHADOW=1
#
# Confidence floor below which a classification collapses to
# SG_NEEDS_TRIAGE. Default 0.85 (DEFAULT_CONFIDENCE_THRESHOLD).
# ASOE_EMAIL_SUPERGROUP_THRESHOLD=0.85

# ── Legacy / local constrained-generation backend ─────────────────────────
# USE_OUTLINES_BACKEND=1 short-circuits the router to the in-process
# Outlines backend (only when ASOE_LLM_PROVIDER resolves to outlines).
# USE_OUTLINES_BACKEND=0
# OUTLINES_MODEL_NAME=microsoft/Phi-3-mini-4k-instruct

# ── Anthropic (claude-sonnet-4-6 default; Foundry-routable) ───────────────
# Sandbox: leave ANTHROPIC_BASE_URL unset to use api.anthropic.com.
# Production: set to the Azure AI Foundry private-endpoint URL —
# direct egress to api.anthropic.com is BLOCKED when ASOE_ENV=production.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://my-foundry.private.example/anthropic
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_DEPLOYMENT=asoe-prod-claude   # forwarded to Foundry as a header
# ANTHROPIC_API_VERSION=2023-06-01

# ── OpenAI / Azure OpenAI / OpenAI-compatible (vLLM, TGI, LiteLLM) ────────
# OPENAI_API_KEY=sk-...
# Direct OpenAI: leave OPENAI_BASE_URL unset (sandbox-only by policy).
# Azure OpenAI: set base_url to the resource endpoint + api_version +
# deployment name; the SDK class auto-switches to AzureOpenAI when
# api_version is present.
# OPENAI_BASE_URL=https://myresource.openai.azure.com
# OPENAI_API_VERSION=2024-02-01
# OPENAI_DEPLOYMENT=asoe-prod-gpt4o
# OPENAI_MODEL=gpt-4o
#
# Self-hosted vLLM/TGI running Qwen/Llama/Mistral: just point
# OPENAI_BASE_URL at the cluster (no api_version → OpenAI() client).
# OPENAI_BASE_URL=https://my-vllm.private.example/v1
# OPENAI_MODEL=Qwen/Qwen2.5-32B-Instruct

# ── Ollama (cloud or self-hosted; OpenAI-compatible tool calling) ─────────
# OLLAMA_BASE_URL=http://localhost:11434         # local sandbox
# OLLAMA_BASE_URL=https://ollama.private.local   # private peering (production-OK)
# OLLAMA_API_KEY=...                              # only for proxied auth
# OLLAMA_MODEL=qwen2.5

# ── HuggingFace Inference (Dedicated Endpoints / Serverless API) ──────────
# Production: must use a Dedicated Inference Endpoint URL.
# Serverless Inference API (no base_url) is sandbox-only by policy.
# HUGGINGFACE_API_KEY=hf_...
# HUGGINGFACE_BASE_URL=https://my-endpoint.endpoints.huggingface.cloud
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-32B-Instruct

# ══════════════════════════════════════════════════════════════════════════
# PRE-PROD / AZURE PARITY VARS (azure-preprod-parity-plan.md)
#
# Everything below is unset by default → the sandbox/local path is
# unchanged. They are documented here so local, Vercel-preview and Azure
# pre-prod can be reconciled from one place. See
# docs/DEPLOYMENT_CONFIG_MATRIX.md for the per-environment matrix.
# ══════════════════════════════════════════════════════════════════════════

# ── CORS (api/app.py::resolve_cors_config; PARITY-0 / ADR-041) ────────────
# Preferred: comma-separated allowlist. Sandbox auto-adds localhost.
# CORS_ALLOWED_ORIGINS=https://asoe-ui.vercel.app
# Legacy single-value form (kept for back-compat):
# CORS_ALLOWED_ORIGIN=https://asoe-ui.vercel.app
# Regex for dynamic origins (e.g. Vercel preview URLs). Validated at
# startup — an over-permissive pattern (.* / SaaS-wildcard) FAILS boot.
# CORS_ALLOWED_ORIGIN_REGEX=^https://asoe-ui-git-[a-z0-9-]+-myteam\.vercel\.app$

# ── Token TTLs (api/deps.py::_resolve_token_ttls) ─────────────────────────
# Empty → env-driven defaults (sandbox 24h / 30d; non-sandbox 60m / 7d).
# ASOE_ACCESS_TOKEN_TTL_SECONDS=
# ASOE_REFRESH_TOKEN_TTL_SECONDS=

# ── Auth mode: seed JWT vs Entra (PARITY-3b; api/deps.py) ─────────────────
# "seed" (default) = HS256 seed tokens. "entra" = Azure AD RS256 + JWKS.
# ASOE_AUTH_MODE=seed
# ASOE_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# ASOE_CLIENT_ID=<entra-app-client-id>
# JSON map of Azure AD group object-id → ASOE role. Default {} (no roles).
# ASOE_AZURE_AD_GROUP_TO_ROLE={"<group-guid>":"admin"}
# JWKS cache / fetch tuning (defaults 3600s / 5s; fails closed on timeout).
# ASOE_JWKS_CACHE_TTL_SECONDS=3600
# ASOE_JWKS_FETCH_TIMEOUT_SECONDS=5
# NextAuth.js session secret (asoe-ui side; injected as a Container App
# secret by the deploy script — rotated per revision unless preserved).
# NEXTAUTH_SECRET=<random-32-bytes>

# ── Attachment signing keys (PARITY-4; api/attachment_read_token.py) ──────
# Distinct from ASOE_JWT_SECRET. SECONDARY is the rotation-overlap slot so
# tokens minted just before a rotation still verify during the cutover.
# ASOE_ATTACHMENT_SIGNING_KEY=<key>
# ASOE_ATTACHMENT_SIGNING_KEY_SECONDARY=<previous-key-during-rotation>

# ── Observability: App Insights + OTel (PARITY-5) ─────────────────────────
# Unset → no telemetry export (stdlib logging only).
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# ── Compliance Shadow on Azure OpenAI (compliance/shadow_llm_azure.py) ────
# Optional: run the (deterministic-locked) Compliance Shadow on Azure
# OpenAI. Unset → deterministic fallback. ASOE_SHADOW_LLM_DISABLED=1 forces
# the shadow tier off entirely.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<key>
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_SHADOW_DEPLOYMENT=<deployment-name>
# ASOE_SHADOW_LLM_DISABLED=0
# Cost-tracking ($/1K tokens; default 0 = untracked):
# ASOE_AZURE_OPENAI_INPUT_USD_PER_1K=0
# ASOE_AZURE_OPENAI_OUTPUT_USD_PER_1K=0

# ── Document extraction / OCR (PARITY-6.2 / 7) ────────────────────────────
# Backend selector: "recorded" (stub, default) | "live" (Azure DI).
# ASOE_DOCUMENT_EXTRACTION_BACKEND=recorded
# ASOE_DOCUMENT_EXTRACTION_MODEL_ID=prebuilt-invoice
# Live Azure Document Intelligence (constructor fails loud without these):
# ASOE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# ASOE_DOCUMENT_INTELLIGENCE_KEY=<key>          # or use managed identity:
# ASOE_DOCUMENT_INTELLIGENCE_USE_MI=0
# Legacy Azure DI primitive (agents/primitives/extract_providers.py):
# AZURE_DI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_DI_API_KEY=<key>
# AZURE_DI_MODEL_ID=prebuilt-document
# OCR primary engine: "stub" (default) | other registered engines.
# ASOE_OCR_PRIMARY=stub
# ASOE_CHANDRA_MODEL_PATH=
# ASOE_CHANDRA_DEVICE=cpu

# ── Live gateway drivers + canary rollout (PARITY-6.1/6.3/6.4) ────────────
# Each driver defaults to "recorded" (stub). Flip to the live value to
# enable the real connector; traffic is then split by the per-connector
# canary percentage (a 0.0–1.0 FLOAT, default 0.0 = no real traffic),
# keyed deterministically on case_id (gateways/canary.py).
# ASOE_EMAIL_INTAKE_DRIVER=recorded            # recorded | graph
# ASOE_CANARY_PCT_EMAIL_INTAKE=0.0
# ASOE_GRAPH_TENANT_ID=<entra-tenant-id>
# ASOE_GRAPH_CLIENT_ID=<graph-app-client-id>
# ASOE_GRAPH_CLIENT_SECRET=<secret>
# ASOE_SAP_DRIVER=recorded                     # recorded | s4hana
# ASOE_CANARY_PCT_SAP=0.0
# ASOE_SAP_HOST=
# ASOE_SAP_CLIENT=100
# ASOE_SAP_USER=
# ASOE_SAP_PASSWORD=
# ASOE_OMS_DRIVER=recorded                     # recorded | live
# ASOE_CANARY_PCT_OMS=0.0
# ASOE_OMS_BASE_URL=
# ASOE_OMS_API_KEY=

# ── Feature flags ─────────────────────────────────────────────────────────
# ASOE_CASE_AGENT_ENABLED=0          # case-agent surface
# ASOE_CASE_COSIGN_ENABLED=0         # dual-control co-sign
# ASOE_EMIT_LEGACY_EVENT_TYPES=0     # emit pre-taxonomy event_type aliases

# ── Data governance / scheduled jobs (PARITY-8) ───────────────────────────
# Retention sweeper (two-step opt-in: bicep deploy flag + this var).
# RETENTION_SWEEPER_ENABLED=0
# ASOE_SWEEP_TENANTS=                # comma-separated allowlist; empty = all
# ASOE_PREPROD_REGION=               # residency check for the sweeper
# Extraction-drift window sizes (defaults 200 / 50).
# ASOE_DRIFT_BASELINE_N=200
# ASOE_DRIFT_RECENT_N=50
# Outbox reconcile scheduler (orchestration/outbox_scheduler.py). OFF
# unless set to a positive number of seconds.
# ASOE_OUTBOX_RECONCILE_INTERVAL_S=30

# ── Test-only (NOT runtime) ───────────────────────────────────────────────
# Live Postgres URL for integration tests (distinct from DATABASE_URL).
# Unset → SQLite in-memory. Used by tests + the Postgres CI selection.
# ASOE_TEST_POSTGRES_URL=postgresql://asoe:asoe@127.0.0.1:5433/asoe_test
# SANDBOX_DB_PATH=                   # override sandbox SQLite file path
# Smoke-client creds (scripts/*; defaults admin@asoe.test / test-password):
# ASOE_API_BASE_URL=
# ASOE_API_EMAIL=admin@asoe.test
# ASOE_API_PASSWORD=test-password
# ASOE_API_PORT=8000
