# =====================================================================
# ADR-038 §8.5 — Five-layer CODEOWNERS map
# =====================================================================
#
# The case-centric architecture (ADR-038) introduces a five-layer
# stack: L0 Knowledge → L1 Deterministic primitives → L2 Bounded
# LLM primitives → L3 Case Agent → L4 Harness. Each layer carries
# distinct review requirements; this section makes them
# machine-enforced.
#
# See: architecture_v5.md §1 (layer responsibilities) and
# docs/adr/ADR-038-case-centric-order-intake.md §8.5.

# L0 — Knowledge layer. Skill bundles, compaction templates, the
# L2 LLM Shadow bundle, SLA policy. Compliance + domain SME hold
# veto on every change since these drive both reasoning surface
# and audit-bearing decisions.
/knowledge/                      @kumarabhijit @linkinrustle
/knowledge/**                    @kumarabhijit @linkinrustle
/knowledge/shadow_llm/           @kumarabhijit @linkinrustle
/knowledge/shadow_llm/**         @kumarabhijit @linkinrustle
/knowledge/compaction/           @kumarabhijit @linkinrustle
/knowledge/compaction/**         @kumarabhijit @linkinrustle
/knowledge/policy/               @kumarabhijit @linkinrustle
/knowledge/policy/**             @kumarabhijit @linkinrustle

# L1 — Deterministic primitives. Recipes, deterministic Compliance
# Shadow, gateway operations, validators. Backend leads; recipes
# also need compliance review when they touch authorisation logic.
/recipes/                        @kumarabhijit @linkinrustle
/recipes/**                      @kumarabhijit @linkinrustle
/compliance/shadow.py            @kumarabhijit @linkinrustle
/gateways/                       @kumarabhijit @linkinrustle
/gateways/**                     @kumarabhijit @linkinrustle
/constraints/                    @kumarabhijit @linkinrustle
/constraints/**                  @kumarabhijit @linkinrustle

# L2 — Bounded LLM primitives. Constrained-output single-call LLM
# primitives (intent classifier, recipe selector, attachment
# extractor, L2 LLM Shadow). Compliance + Tools Admin hold veto
# alongside engineering — these calls feed verdicts capable of
# escalating cases (L2 LLM Shadow) or extracting audit-bearing
# fields from documents (extract_attachment).
/compliance/shadow_llm.py        @kumarabhijit @linkinrustle
/compliance/shadow_llm_azure.py  @kumarabhijit @linkinrustle
/agents/primitives/              @kumarabhijit @linkinrustle
/agents/primitives/**            @kumarabhijit @linkinrustle
