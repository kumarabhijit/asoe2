/constraints/llm_backend.py      @kumarabhijit @linkinrustle
/constraints/router.py           @kumarabhijit @linkinrustle

# L3 — Case Agent. The bounded while-loop, working-memory loader,
# tool registry, budget enforcer. Engineering + Compliance veto
# (the agent's tool-call sequence is the audit replay subject).
/agents/case_agent.py            @kumarabhijit @linkinrustle
