# .dockerignore ─ exclude files not needed in any ASOE image
# NOTE: .python-version and uv.lock are intentionally NOT excluded —
# they are copied into images to pin Python 3.14 and lock dependencies.
.git
.gitignore
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.coverage
htmlcov/
dist/
build/
*.egg-info/
.venv/
venv/
.env
.env.*
tests/sandbox/sandbox.db
tests/sandbox/db/*.db
*.log
.DS_Store
k8s/
infra/
docs/
# Re-include the duplicate-po config-defaults sub-tree —
# `gateways/tenant_config.py::_PLATFORM_DEFAULTS_PATH` reads
# `docs/specs/duplicate-po/config-defaults.json` at gateway-
# instantiation time. Without this exception the docker build
# context omits the file even when Dockerfile.api COPYs it
# explicitly, producing "file not found in build context" at COPY
# time and a Container App that crashloops on first start.
!docs/specs/duplicate-po/
.github/
.claude/
tests/
# Top-level markdown docs (skills/*_SKILL.md, prompts/*.md, and
# compliance/*.md are kept — they live inside dirs that are explicitly
# COPYed and are read at runtime).
/README.md
/CLAUDE.md
/DESIGN.md
/ARCHITECTURE.md
/architecture_v2.md
/architecture_v3.md
/tasks.md
/Login
