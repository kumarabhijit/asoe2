# Dockerfile.api ─ ASOE FastAPI HTTP server (Azure Container Apps target)
#
# Contains: FastAPI application factory (api/app.py) + all imported
# packages (contracts, constraints, compliance, recipes, skills,
# gateways, workflows, orchestration, observability, hardening, llm,
# prompts, db). Exposes uvicorn on :8000.
#
# Python: 3.14.3 (pinned via .python-version and pyproject.toml)
# Package manager: uv (fast, deterministic, reproducible)
#
# Build:   docker build -f Dockerfile.api -t asoe-api .
# Run:     docker run --rm -p 8000:8000 --env-file .env asoe-api

FROM python:3.14-slim AS base

WORKDIR /app

# ── Proxy support (optional, pass at build time) ─────────────────────────────
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY=""

# ── System deps ─────────────────────────────────────────────────────────────
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# ── uv: fast, deterministic dep resolution ──────────────────────────────────
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# ── Python deps — API runtime (no torch / transformers / outlines) ──────────
# We install the same core set as Dockerfile.core plus FastAPI/uvicorn/redis,
# and the anthropic SDK so ASOE_LLM_PROVIDER=anthropic works out of the box,
# plus the openai SDK so ASOE_EMBEDDING_PROVIDER=openai (precedents semantic
# matching, sign-off 2026-06-10) and llmProvider=openai are enable-by-env —
# feature parity with local/.env.example without an image rebuild.
COPY pyproject.toml uv.lock ./
RUN uv pip install --system --no-cache-dir \
    "langgraph>=0.2.0" \
    "pydantic>=2.7.0" \
    "fastapi>=0.110.0" \
    "uvicorn[standard]>=0.29.0" \
    "redis>=5.0.0" \
    "pyyaml>=6.0" \
    "psycopg2-binary>=2.9.0" \
    "anthropic>=0.40.0" \
    "openai>=1.50.0" \
    "langfuse>=2.0.0"

# ── Compatibility patch (Python 3.14 typing API change) ─────────────────────
COPY scripts/apply-patches.sh scripts/apply-patches.sh
RUN bash scripts/apply-patches.sh python3

# ── Application source ──────────────────────────────────────────────────────
COPY contracts/    contracts/
COPY constraints/  constraints/
COPY compliance/   compliance/
COPY recipes/      recipes/
COPY skills/       skills/
COPY knowledge/    knowledge/
COPY agents/       agents/
COPY gateways/     gateways/
COPY workflows/    workflows/
COPY orchestration/ orchestration/
COPY observability/ observability/
COPY hardening/    hardening/
COPY llm/          llm/
COPY prompts/      prompts/
COPY api/          api/
COPY db/           db/
# Scenario catalog — the single declarative source the sandbox case
# bootstrap (api/sandbox_bootstrap.py) materialises into real cases when
# ASOE_ENV=sandbox + ASOE_SANDBOX_BOOTSTRAP=1. Harmless in other envs (the
# bootstrap is gated off), and small.
COPY fixtures/scenarios/ fixtures/scenarios/

# ── Runtime config ──────────────────────────────────────────────────────────
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV ASOE_KILL_SWITCH=0
ENV ASOE_EXPLAIN_MODE=0
ENV PORT=8000

# Non-root user (Azure Container Apps does not enforce this, but it's
# good hygiene and matches Dockerfile.core).
RUN adduser --disabled-password --gecos "" --uid 1000 asoe \
    && chown -R asoe:asoe /app
USER asoe

EXPOSE 8000

# Health check matches the Container App probe target (/api/v1/health).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/v1/health || exit 1

# Single-worker uvicorn — Container Apps scales horizontally via replicas,
# not vertically via workers. Set --proxy-headers so X-Forwarded-* from
# the Container Apps ingress is honoured.
CMD ["sh", "-c", "uvicorn api.app:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
