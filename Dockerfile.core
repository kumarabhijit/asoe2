# Dockerfile.core ─ ASOE core orchestration engine
#
# Contains: LangGraph state machine, recipes, Compliance Shadow, constraints,
#           gateways, observability, hardening. No UI. No GPU dependencies.
#
# Python: 3.14.3 (stable) — pinned via .python-version and pyproject.toml
# Package manager: uv (fast, deterministic, reproducible)
# Production entry: replace CMD with your Azure Event Hubs consumer.
# Local dev:        docker compose up core
#
# Image size target: < 500 MB (slim base + pure-Python deps only)

FROM python:3.14-slim AS base

WORKDIR /app

# ── System deps ───────────────────────────────────────────────────────────────
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# ── uv: fast, deterministic dep resolution (per architecture_v2.md §2) ───────
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# ── Python deps — core only (no torch, no streamlit) ─────────────────────────
# Install from lock file for reproducibility; patch for Python 3.14 typing API change.
COPY pyproject.toml uv.lock ./
RUN uv pip install --system --no-cache-dir \
    "langgraph>=0.2.0" \
    "pydantic>=2.7.0"

# ── Compatibility patch ───────────────────────────────────────────────────────
# pydantic 2.12.5 calls typing._eval_type(prefer_fwd_module=True) but Python
# 3.14 renamed that kwarg to parent_fwdref. Patch until pydantic ships a fix.
COPY scripts/apply-patches.sh scripts/apply-patches.sh
RUN bash scripts/apply-patches.sh python3

# ── Application source ────────────────────────────────────────────────────────
COPY contracts/    contracts/
COPY constraints/  constraints/
COPY compliance/   compliance/
COPY recipes/      recipes/
COPY skills/       skills/
COPY gateways/     gateways/
COPY workflows/    workflows/
COPY orchestration/ orchestration/
COPY observability/ observability/
COPY hardening/    hardening/
COPY llm/          llm/
COPY prompts/      prompts/
COPY main.py       main.py

# ── Runtime config ────────────────────────────────────────────────────────────
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV ASOE_KILL_SWITCH=0
ENV ASOE_EXPLAIN_MODE=0
ENV USE_OUTLINES_BACKEND=0

# Non-root user for AKS pod security policy compliance
RUN adduser --disabled-password --gecos "" --uid 1000 asoe
USER asoe

# Smoke-test / single-event demo.
# Production: override with Event Hubs consumer:
#   CMD ["python", "event_consumer.py"]
CMD ["python", "main.py"]
